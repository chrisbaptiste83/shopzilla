#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Prepare the schema whenever this command starts a Rails server. ECS appends
# bind/port flags, and the Docker default may prefix the server with Thruster,
# so checking only the final arguments silently skipped migrations in both
# cases. Catalog reconciliation is intentionally an explicit release action;
# never run db:seed implicitly on a container restart.
if [[ " $* " == *" ./bin/rails server "* ]]; then
  ./bin/rails db:prepare
fi

exec "${@}"
