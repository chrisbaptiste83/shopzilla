<div class="min-h-screen flex">

  <!-- Left: Image panel (hidden on mobile) -->
  <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden">
    <%= image_tag "categories/studio.jpg", class: "absolute inset-0 w-full h-full object-cover", alt: "" %>
    <div class="absolute inset-0 bg-gradient-to-br from-teal-900/80 via-teal-800/50 to-transparent"></div>
    <div class="relative z-10 flex flex-col justify-end p-12 text-white">
      <p class="sz-section-label mb-2" style="color:rgba(255,255,255,0.7);background:transparent;border:none;padding:0;">Gloria's Embroidery Studio</p>
      <h2 class="text-4xl font-bold leading-tight mb-3">Welcome<br>Back</h2>
      <p class="text-white/70 text-sm max-w-xs leading-relaxed">Browse your designs, track your orders, and download your purchases — all in one place.</p>
    </div>
  </div>

  <!-- Right: Form panel -->
  <div class="flex-1 flex items-center justify-center p-8 bg-base-100">
    <div class="w-full max-w-sm">

      <div class="mb-8 text-center">
        <h1 class="sz-headline mb-1">Log In</h1>
        <p class="text-gray-500 text-sm">
          Don't have an account?
          <%= link_to "Sign up", new_user_registration_path, class: "text-teal-700 font-semibold hover:underline" %>
        </p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div>
          <%= f.label :email, "Email Address", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "input input-bordered w-full", placeholder: "you@email.com" %>
        </div>

        <div>
          <div class="flex justify-between items-baseline mb-1.5">
            <%= f.label :password, "Password", class: "block text-sm font-semibold text-gray-700" %>
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs text-teal-700 hover:underline" %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password",
                class: "input input-bordered w-full", placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.check_box :remember_me, class: "checkbox checkbox-sm checkbox-primary" %>
            <span class="text-sm text-gray-600">Remember me</span>
          </label>
        <% end %>

        <div class="pt-2">
          <%= f.submit "Log In", class: "sz-cta-primary w-full justify-center" %>
        </div>
      <% end %>

      <% if devise_mapping.omniauthable? %>
        <div class="divider text-xs text-gray-400 my-5">OR CONTINUE WITH</div>
        <div class="space-y-2">
          <% resource_class.omniauth_providers.each do |provider| %>
            <% provider_name = provider.to_s == "google_oauth2" ? "Google" : OmniAuth::Utils.camelize(provider) %>
            <% provider_name = "GitHub" if provider.to_s == "github" %>
            <%= button_to "Continue with #{provider_name}",
                  omniauth_authorize_path(resource_name, provider),
                  method: :post,
                  data: { turbo: false },
                  form_class: "auth-provider-form",
                  class: "btn btn-outline w-full" %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>

</div>
