<div class="dashboard-dark">
  <div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-8 py-4 relative z-10">
    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><%= link_to "Dashboard", dashboard_path %></li>
        <li class="font-semibold text-dark-primary">Order History</li>
      </ul>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-1">Order History</h1>
      <p class="text-dark-secondary">All your past purchases</p>
    </div>

    <% if @orders.any? %>
      <div class="space-y-4">
        <% @orders.each do |order| %>
          <div class="card-dark rounded-2xl">
            <div class="p-5">
              <!-- Order Header -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 pb-4" style="border-bottom: 1px solid rgba(148, 163, 184, 0.1);">
                <div>
                  <h3 class="text-lg font-semibold text-dark-primary">Order #<%= order.id %></h3>
                  <p class="text-sm text-dark-muted"><%= order.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
                </div>
                <div class="flex items-center gap-4 mt-2 sm:mt-0">
                  <%
                    status_class = case order.status
                      when 'completed' then 'badge-success'
                      when 'pending' then 'badge-warning'
                      when 'failed' then 'badge-error'
                      when 'cancelled' then 'badge-ghost'
                      else 'badge-info'
                    end
                  %>
                  <span class="badge <%= status_class %>"><%= order.status.capitalize %></span>
                  <span class="text-lg font-bold" style="color: #2dd4bf;">$<%= '%.2f' % order.total %></span>
                </div>
              </div>

              <!-- Order Items -->
              <div class="space-y-2">
                <% order.order_items.each do |item| %>
                  <div class="flex items-center justify-between py-2">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded overflow-hidden flex-shrink-0" style="background: rgba(148, 163, 184, 0.1);">
                        <% if item.product.images.attached? %>
                          <%= image_tag item.product.images.first.variant(resize_to_fill: [80, 80]), class: "w-full h-full object-cover" %>
                        <% else %>
                          <div class="w-full h-full flex items-center justify-center text-lg opacity-50">✂️</div>
                        <% end %>
                      </div>
                      <%= link_to item.product.title, product_path(item.product), class: "text-sm text-dark-secondary hover:text-teal-400 transition-colors" %>
                      <span class="text-xs text-dark-muted">x<%= item.quantity %></span>
                    </div>
                    <span class="text-sm font-medium text-dark-primary">$<%= '%.2f' % (item.unit_price * item.quantity) %></span>
                  </div>
                <% end %>
              </div>

              <!-- Download notice for completed orders -->
              <% if order.status == 'completed' %>
                <div class="mt-4 pt-3" style="border-top: 1px solid rgba(148, 163, 184, 0.1);">
                  <div class="flex items-center gap-2 text-sm" style="color: #2dd4bf;">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Order complete - check your <%= link_to "downloads", dashboard_downloads_path, class: "underline hover:no-underline" %> for your files.</span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card-dark rounded-2xl">
        <div class="p-16 text-center">
          <div class="text-6xl mb-4 opacity-60">📦</div>
          <h2 class="text-2xl font-bold mb-2 text-dark-primary">No orders yet</h2>
          <p class="text-dark-secondary mb-6">Start shopping to see your orders here!</p>
          <%= link_to "Browse Products", products_path, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
