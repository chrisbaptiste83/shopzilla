<% content_for :page_title, @category.name %>
<% content_for :meta_description, "Browse #{@category.name.downcase} embroidery designs from Gloria's Embroidery Shop." %>

<nav class="text-sm breadcrumbs mb-6 opacity-70" aria-label="Breadcrumb">
  <ul>
    <li><%= link_to "Home", root_path %></li>
    <li><%= link_to "Designs", products_path %></li>
    <li><%= @category.name %></li>
  </ul>
</nav>

<header class="category-hero">
  <%= image_tag category_banner_image(@category),
        class: "category-hero-media",
        alt: "#{@category.name} embroidery collection" %>
  <div class="category-hero-overlay" aria-hidden="true"></div>
  <div class="category-hero-copy">
    <p class="sz-section-label">Collection</p>
    <h1><%= @category.name %></h1>
    <% if @category.description.present? %>
      <p><%= @category.description %></p>
    <% end %>
    <small><%= pluralize(@products.total_count, "design") %></small>
  </div>
</header>

<% if @products.any? %>
  <div class="product-card-grid">
    <%= render partial: "products/catalog_product", collection: @products, as: :product %>
  </div>

  <% if @products.total_pages > 1 %>
    <nav class="mt-10 flex justify-center" aria-label="Collection pages">
      <%= paginate @products %>
    </nav>
  <% end %>
<% else %>
  <div class="catalog-empty">
    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
    </svg>
    <h2>No designs here yet</h2>
    <p>Browse the full catalog while this collection is being prepared.</p>
    <%= link_to "View all designs", products_path, class: "btn btn-primary" %>
  </div>
<% end %>
