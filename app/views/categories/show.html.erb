<!-- app/views/categories/show.html.erb -->
<div class="container mx-auto px-4 py-6">

  <!-- Breadcrumb -->
  <nav class="text-sm mb-6">
    <ol class="flex items-center gap-2 text-base-content/50">
      <li><%= link_to "Home", root_path, class: "hover:text-primary transition-colors" %></li>
      <li><span>/</span></li>
      <li><%= link_to "Categories", products_path, class: "hover:text-primary transition-colors" %></li>
      <li><span>/</span></li>
      <li class="text-base-content font-medium"><%= @category.name %></li>
    </ol>
  </nav>

  <!-- Category Header -->
  <div class="relative overflow-hidden rounded-2xl mb-8 h-48 sm:h-60">
    <%= image_tag category_banner_image(@category),
          class: "w-full h-full object-cover",
          alt: @category.name %>
    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/25 to-transparent"></div>
    <div class="absolute inset-0 flex flex-col justify-end p-6">
      <h1 class="text-3xl font-bold text-white mb-1"><%= @category.name %></h1>
      <% if @category.description.present? %>
        <p class="text-white/75 text-sm max-w-xl"><%= @category.description %></p>
      <% end %>
      <p class="text-white/50 text-xs mt-1"><%= @products.total_count %> designs</p>
    </div>
  </div>

  <% if @products.present? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-5">
      <% @products.each do |product| %>
        <div class="group">
          <!-- Image -->
          <%= link_to product_path(product) do %>
            <div class="relative overflow-hidden rounded-xl bg-neutral-900 mb-3">
              <% if product.images.attached? %>
                <%= image_tag product.images.first,
                      class: "w-full h-48 object-contain group-hover:scale-105 transition-transform duration-300" %>
              <% else %>
                <div class="w-full h-48 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              <% end %>

              <!-- Wishlist button -->
              <% if user_signed_in? %>
                <div class="absolute top-2 right-2">
                  <% if in_wishlist?(product) %>
                    <%= form_with url: wishlist_item_path(wishlist_item_for(product)), method: :delete, local: true do %>
                      <button type="submit" class="btn btn-circle btn-xs btn-error opacity-80">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                      </button>
                    <% end %>
                  <% else %>
                    <%= form_with url: wishlist_items_path, method: :post, local: true do %>
                      <%= hidden_field_tag :product_id, product.id %>
                      <button type="submit" class="btn btn-circle btn-xs bg-base-100/70 backdrop-blur hover:bg-base-100 border-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                      </button>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- Info -->
          <div class="px-1">
            <h3 class="font-semibold text-sm mb-1 group-hover:text-primary transition-colors leading-snug line-clamp-2">
              <%= link_to product.title, product_path(product) %>
            </h3>
            <div class="flex items-center justify-between">
              <span class="font-bold text-primary">$<%= product.price %></span>
              <% if product.stitch_count.present? %>
                <span class="text-xs text-base-content/45"><%= number_with_delimiter(product.stitch_count) %> sts</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @products.respond_to?(:total_pages) && @products.total_pages > 1 %>
      <div class="mt-10 flex justify-center">
        <%= paginate @products %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-20">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto opacity-20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
      </svg>
      <p class="text-base-content/50 text-lg">No designs in this category yet.</p>
      <%= link_to "Browse all designs", products_path, class: "btn btn-primary btn-sm mt-4" %>
    </div>
  <% end %>
</div>
