<% content_for :page_title, "Order Confirmed" %>

<section class="checkout-state">
  <div class="checkout-state-icon checkout-state-icon-success" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
  </div>
  <p class="sz-section-label">Payment received</p>
  <h1>Order confirmed</h1>
  <p class="checkout-state-lead">Your receipt is on its way. Your available files are ready below and will remain in your account.</p>

  <% if @download_accesses.any? %>
    <div class="download-list" aria-label="Your downloads">
      <% @download_accesses.each do |download_access| %>
        <% if download_access.product&.embroidery_file&.attached? %>
          <article class="download-item">
            <div>
              <h2><%= download_access.product.title %></h2>
              <p>Available until <%= download_access.expires_at.strftime("%B %d, %Y") %></p>
            </div>
            <%= link_to "Download file", secure_download_path(download_access.access_token), class: "btn btn-primary btn-sm" %>
          </article>
        <% else %>
          <div class="alert alert-info">
            <span>Your download for "<%= download_access.product&.title || "this product" %>" is still being prepared.</span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info max-w-xl">
      <span>Your download links will be available shortly. Check your account for access.</span>
    </div>
  <% end %>

  <div class="checkout-state-actions">
    <%= link_to "View downloads", dashboard_downloads_path, class: "btn btn-primary" %>
    <%= link_to "Continue shopping", products_path, class: "btn btn-ghost" %>
  </div>
</section>
