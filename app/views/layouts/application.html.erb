<!DOCTYPE html>
<html>
<head>
  <title><%= content_for?(:page_title) ? "#{yield(:page_title)} | Gloria's Embroidery Shop" : "Gloria's Embroidery Shop" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "Beautiful hand-crafted embroidery designs. Download PES files for immediate use." %>">

  <!-- Open Graph -->
  <meta property="og:site_name" content="Gloria's Embroidery Shop">
  <meta property="og:title" content="<%= content_for?(:og_title) ? yield(:og_title) : "Gloria's Embroidery Shop" %>">
  <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : "Beautiful hand-crafted embroidery designs. Download PES files for immediate use." %>">
  <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : "website" %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <% if content_for?(:og_image) %>
    <meta property="og:image" content="<%= yield(:og_image) %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="1200">
  <% end %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= content_for?(:og_title) ? yield(:og_title) : "Gloria's Embroidery Shop" %>">
  <meta name="twitter:description" content="<%= content_for?(:og_description) ? yield(:og_description) : "Beautiful hand-crafted embroidery designs." %>">
  <% if content_for?(:og_image) %>
    <meta name="twitter:image" content="<%= yield(:og_image) %>">
  <% end %>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Parisienne&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "bundle", "data-turbo-track": "reload", type: "module", nonce: false %>
</head>
<body class="text-high-contrast">
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Navigation Bar (hidden in native mobile wrapper) -->
  <% unless turbo_native_app? %>
  <% navigation_categories = Category.with_available_products.limit(8) %>
  <% cart_count = (session[:cart] || {}).values.sum %>
  <% designs_active = controller_name.in?(%w[products categories]) %>
  <% about_active = current_page?(about_path) %>
  <% contact_active = current_page?(contact_path) %>
  <header class="site-header sticky top-0 z-50">
    <nav class="navbar min-h-16 max-w-7xl mx-auto px-4 sm:px-6" aria-label="Primary navigation">
      <div class="navbar-start gap-2">
        <details class="dropdown lg:hidden">
          <summary class="btn btn-ghost btn-square list-none" aria-label="Open navigation menu">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </summary>
          <ul class="menu menu-sm dropdown-content mt-3 z-10 p-2 shadow-lg rounded-lg w-64">
            <li><%= link_to "All designs", products_path,
                      class: class_names("nav-link-active": designs_active),
                      aria: { current: ("page" if designs_active) } %></li>
            <% navigation_categories.each do |category| %>
              <li><%= link_to category.name, category_path(category) %></li>
            <% end %>
            <li><%= link_to "About", about_path,
                      class: class_names("nav-link-active": about_active),
                      aria: { current: ("page" if about_active) } %></li>
            <li><%= link_to "Contact", contact_path,
                      class: class_names("nav-link-active": contact_active),
                      aria: { current: ("page" if contact_active) } %></li>
            <% if user_signed_in? %>
              <li class="menu-title mt-2"><span>Account</span></li>
              <li><%= link_to "Dashboard", dashboard_path %></li>
              <li><%= link_to "Orders", dashboard_orders_path %></li>
              <li><%= link_to "Downloads", dashboard_downloads_path %></li>
              <li><%= link_to "Wishlist", dashboard_wishlist_path %></li>
              <% if current_user.admin? %>
                <li><%= link_to "Admin panel", admin_root_path if defined?(admin_root_path) %></li>
              <% end %>
              <li>
                <%= button_to "Log out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "btn btn-ghost btn-sm text-error w-full justify-start" %>
              </li>
            <% else %>
              <li class="menu-title mt-2"><span>Account</span></li>
              <li><%= link_to "Log in", new_user_session_path %></li>
              <li><%= link_to "Create account", new_user_registration_path %></li>
            <% end %>
          </ul>
        </details>

        <%= link_to root_path, class: "site-brand", aria: { label: "Gloria's Embroidery Shop home" } do %>
          <span class="site-brand-mark" aria-hidden="true">G</span>
          <span class="site-brand-name">
            <span>Gloria's</span>
            <small>Embroidery Shop</small>
          </span>
        <% end %>
      </div>

      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal gap-1">
          <li><%= link_to "All designs", products_path,
                    class: class_names("font-medium", "nav-link-active": designs_active),
                    aria: { current: ("page" if designs_active) } %></li>
          <li>
            <details>
              <summary class="font-medium">Categories</summary>
              <ul class="p-2 rounded-lg w-56">
                <% navigation_categories.each do |category| %>
                  <li><%= link_to category.name, category_path(category) %></li>
                <% end %>
              </ul>
            </details>
          </li>
          <li><%= link_to "About", about_path,
                    class: class_names("font-medium", "nav-link-active": about_active),
                    aria: { current: ("page" if about_active) } %></li>
          <li><%= link_to "Contact", contact_path,
                    class: class_names("font-medium", "nav-link-active": contact_active),
                    aria: { current: ("page" if contact_active) } %></li>
        </ul>
      </div>

      <div class="navbar-end gap-1">
        <%= form_with url: products_path, method: :get, local: true, class: "hidden xl:block" do |f| %>
          <%= f.label :search, "Search designs", class: "sr-only", for: "site-search" %>
          <%= f.search_field :search, id: "site-search", placeholder: "Search designs", class: "input input-bordered input-sm w-44", value: params[:search], autocomplete: "off" %>
        <% end %>

        <% if user_signed_in? %>
          <% wishlist_count = current_user.wishlist_items.count %>
          <%= link_to wishlist_items_path, class: "btn btn-ghost btn-circle", aria: { label: "Wishlist, #{pluralize(wishlist_count, 'item')}" }, title: "Wishlist" do %>
            <span class="indicator">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
              <% if wishlist_count.positive? %>
                <span class="badge badge-xs badge-secondary indicator-item"><%= wishlist_count %></span>
              <% end %>
            </span>
          <% end %>
        <% end %>

        <%= link_to cart_path, class: "btn btn-ghost btn-circle", aria: { label: "Cart, #{pluralize(cart_count, 'item')}" }, title: "Cart" do %>
          <span class="indicator">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.3 2.6A1 1 0 006.6 17H18m-9 4h.01M17 21h.01" />
            </svg>
            <% if cart_count.positive? %>
              <span class="badge badge-xs badge-primary indicator-item"><%= cart_count %></span>
            <% end %>
          </span>
        <% end %>

        <% if user_signed_in? %>
          <details class="dropdown dropdown-end hidden lg:block">
            <summary class="btn btn-ghost btn-circle list-none" aria-label="Open account menu">
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar.variant(resize_to_fill: [80, 80]), class: "account-avatar", alt: "" %>
              <% else %>
                <span class="account-avatar account-avatar-fallback" aria-hidden="true"><%= current_user.email.first.upcase %></span>
              <% end %>
            </summary>
            <ul class="menu menu-sm dropdown-content mt-3 z-10 p-2 shadow-lg rounded-lg w-60">
              <li class="menu-title"><span class="truncate"><%= current_user.email %></span></li>
              <li><%= link_to "Dashboard", dashboard_path %></li>
              <li><%= link_to "Orders", dashboard_orders_path %></li>
              <li><%= link_to "Downloads", dashboard_downloads_path %></li>
              <li><%= link_to "Wishlist", dashboard_wishlist_path %></li>
              <% if current_user.admin? %>
                <li class="menu-title mt-2"><span>Store management</span></li>
                <li><%= link_to "Admin panel", admin_root_path if defined?(admin_root_path) %></li>
              <% end %>
              <li class="mt-1">
                <%= button_to "Log out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "btn btn-ghost btn-sm text-error w-full justify-start" %>
              </li>
            </ul>
          </details>
        <% else %>
          <%= link_to "Log in", new_user_session_path, class: "btn btn-ghost btn-sm hidden lg:inline-flex" %>
          <%= link_to "Create account", new_user_registration_path, class: "btn btn-primary btn-sm hidden lg:inline-flex" %>
        <% end %>
      </div>
    </nav>
  </header>
  <% end %>

  <!-- Main Content -->
  <main id="main-content" class="container mx-auto px-4 md:px-6 pt-4 relative z-10 page-surface" tabindex="-1">
    <% if notice %>
      <div class="alert alert-success shadow-lg mb-4 flash-message">
        <span><%= notice %></span>
      </div>
    <% end %>
    <% if alert %>
      <div class="alert alert-error shadow-lg mb-4 flash-message">
        <span><%= alert %></span>
      </div>
    <% end %>
    <%= yield %>
  </main>

  <!-- Footer (hidden in native mobile wrapper) -->
  <% unless turbo_native_app? %>
  <footer class="site-footer mt-16">
    <div class="max-w-7xl mx-auto px-6 py-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="sm:col-span-2 lg:col-span-1">
        <%= link_to root_path, class: "site-brand mb-4 inline-flex" do %>
          <span class="site-brand-mark" aria-hidden="true">G</span>
          <span class="site-brand-name"><span>Gloria's</span><small>Embroidery Shop</small></span>
        <% end %>
        <p class="text-sm text-base-content/60 max-w-xs">Machine-ready embroidery designs, tested and ready to download.</p>
      </div>
      <nav aria-label="Shop links">
        <h2 class="footer-title">Shop</h2>
        <%= link_to "All designs", products_path, class: "link link-hover" %>
        <% navigation_categories.first(3).each do |category| %>
          <%= link_to category.name, category_path(category), class: "link link-hover" %>
        <% end %>
      </nav>
      <nav aria-label="Company links">
        <h2 class="footer-title">Company</h2>
        <%= link_to "About Gloria's", about_path, class: "link link-hover" %>
        <%= link_to "Contact", contact_path, class: "link link-hover" %>
      </nav>
      <nav aria-label="Account links">
        <h2 class="footer-title">Account</h2>
        <% if user_signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "link link-hover" %>
          <%= link_to "Orders", dashboard_orders_path, class: "link link-hover" %>
          <%= link_to "Downloads", dashboard_downloads_path, class: "link link-hover" %>
        <% else %>
          <%= link_to "Log in", new_user_session_path, class: "link link-hover" %>
          <%= link_to "Create account", new_user_registration_path, class: "link link-hover" %>
        <% end %>
      </nav>
    </div>
    <div class="max-w-7xl mx-auto px-6 py-4 border-t border-base-300 text-xs text-base-content/55">
      &copy; <%= Time.current.year %> Gloria's Embroidery Shop. All rights reserved.
    </div>
  </footer>
  <% end %>
</body>
</html>
