<!-- Hero Banner -->
<div class="relative overflow-hidden rounded-2xl mb-10 h-52 sm:h-64">
  <%= image_tag "categories/floral.jpg", class: "w-full h-full object-cover", alt: "Contact us" %>
  <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/25 to-transparent"></div>
  <div class="absolute inset-0 flex flex-col justify-end p-7">
    <p class="sz-section-label" style="color:rgba(255,255,255,0.7);background:transparent;border:none;padding:0;margin-bottom:4px;">Get in Touch</p>
    <h1 class="sz-headline mb-1" style="color:#fff;font-size:clamp(1.8rem,3vw,2.8rem);">
      We'd Love to <span style="background:linear-gradient(135deg,#5eead4,#fcd34d);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Hear From You</span>
    </h1>
  </div>
</div>

<div class="max-w-4xl mx-auto mb-16 px-1">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Contact Info -->
    <div class="space-y-4">
      <div class="sz-feature-item items-start text-left">
        <div class="sz-feature-icon flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color:#0f766e" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900 text-sm mb-0.5">Email</h3>
          <p class="text-sm text-gray-500">support@gloriasembroidery.com</p>
        </div>
      </div>

      <div class="sz-feature-item items-start text-left">
        <div class="sz-feature-icon flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color:#0f766e" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900 text-sm mb-0.5">Response Time</h3>
          <p class="text-sm text-gray-500">Within 24–48 hours</p>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="lg:col-span-2">
      <div class="sz-product-card p-8">
        <p class="sz-section-label mb-1">Message Us</p>
        <h2 class="sz-section-title mb-6">Send Us a Message</h2>

        <%= form_with url: contact_path, method: :post, local: true do |form| %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <div>
              <%= form.label :name, "Your Name", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
              <%= form.text_field :name, class: "input input-bordered w-full", placeholder: "Gloria" %>
            </div>
            <div>
              <%= form.label :email, "Email Address", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
              <%= form.email_field :email, class: "input input-bordered w-full", placeholder: "you@email.com" %>
            </div>
          </div>

          <div class="mb-4">
            <%= form.label :subject, "Topic", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <%= form.select :subject,
                ["General Inquiry", "Order Support", "Design Request", "Technical Help", "Feedback"],
                { prompt: "Select a topic" },
                class: "select select-bordered w-full" %>
          </div>

          <div class="mb-6">
            <%= form.label :message, "Message", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <%= form.text_area :message, rows: 5, class: "textarea textarea-bordered w-full", placeholder: "How can we help you?" %>
          </div>

          <%= form.submit "Send Message", class: "sz-cta-primary w-full justify-center" %>
        <% end %>
      </div>
    </div>

  </div>
</div>
