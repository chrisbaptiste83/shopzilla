<!-- Page Header -->
<div class="mb-2 pt-6 px-1">
  <p class="sz-section-label">Our Story</p>
  <h1 class="sz-headline">
    Passion Behind<br>
    <span class="sz-gradient-text">Every Stitch</span>
  </h1>
</div>
<div class="sz-divider mt-4 mb-12"></div>

<div class="max-w-4xl mx-auto mb-16 px-1">

  <!-- Story -->
  <div class="sz-product-card p-8 mb-6">
    <p class="sz-section-label mb-1">Welcome</p>
    <h2 class="sz-section-title mb-5">About Gloria's Embroidery Shop</h2>
    <p class="text-gray-600 leading-relaxed mb-4">
      Welcome to Gloria's Embroidery Shop! We specialize in high-quality, downloadable embroidery files designed for professionals and hobbyists alike.
    </p>
    <p class="text-gray-500 leading-relaxed">
      Our mission is to provide unique, creative, and affordable designs that help bring your stitching projects to life. Each design is crafted with care and tested to ensure the best results on your embroidery machine.
    </p>
  </div>

  <!-- Values -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
    <div class="sz-feature-item">
      <div class="sz-feature-icon">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color:#0f766e" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-1 text-sm">Passion</h3>
        <p class="text-sm text-gray-500">Every design is created with love and attention to detail.</p>
      </div>
    </div>
    <div class="sz-feature-item">
      <div class="sz-feature-icon">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color:#0f766e" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-1 text-sm">Quality</h3>
        <p class="text-sm text-gray-500">Professional-grade designs tested on real machines.</p>
      </div>
    </div>
    <div class="sz-feature-item">
      <div class="sz-feature-icon">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color:#0f766e" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-1 text-sm">Community</h3>
        <p class="text-sm text-gray-500">Supporting crafters and creators worldwide.</p>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="rounded-2xl p-10 text-center" style="background:linear-gradient(135deg,#0f766e 0%,#0d9488 50%,#b45309 100%);">
    <h2 class="font-bold text-white text-2xl mb-3" style="font-family:'Fraunces',Georgia,serif;">Ready to Start Creating?</h2>
    <p class="text-white/80 mb-6">Browse our collection of beautiful embroidery designs.</p>
    <%= link_to "Shop Now", products_path, class: "sz-cta-outline", style: "color:white!important;border-color:rgba(255,255,255,0.45);" %>
  </div>

</div>
