
<!-- Hero Section -->
<div class="hero min-h-[80vh] bg-gradient-to-br from-teal-900 via-green-900 to-amber-800 mb-8 md:mb-12 relative"
     data-controller="hero-three"
     style="position: relative;">
  <div class="hero-overlay bg-black bg-opacity-40"></div>
  <div class="hero-content text-center text-neutral-content relative z-10 px-4">
    <div class="max-w-2xl" data-controller="scroll-animation" data-scroll-animation-animation-value="scale-up">
      <h1 class="mb-5 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-gradient-hero">
        Unique <span class="text-amber-200">Embroidery</span> Designs
      </h1>
      <p class="mb-6 md:mb-8 text-base sm:text-lg md:text-xl leading-relaxed text-white/90">
        Discover our premium collection of high-quality embroidery files and patterns.
        Perfect for crafters, professionals, and creative enthusiasts.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <%= link_to "Shop Now", products_path, class: "btn btn-accent btn-lg" %>
        <%= link_to "Browse Categories", "#categories", class: "btn btn-outline btn-lg text-white border-white hover:bg-white hover:text-primary" %>
      </div>
      <div class="mt-8 flex flex-wrap justify-center items-center gap-8 text-sm opacity-90">
        <div class="flex items-center gap-2">
          <span class="text-2xl">✨</span>
          <span>Premium Quality</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-2xl">⚡</span>
          <span>Instant Download</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-2xl">🎯</span>
          <span>Multiple Formats</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .text-gradient-hero {
    background: linear-gradient(135deg, #ffffff 0%, #ecfeff 55%, #fef3c7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

<!-- Categories Section -->
<section id="categories" class="mb-12 md:mb-16 px-2 sm:px-0">
  <div class="text-center mb-8 md:mb-12" data-controller="scroll-animation" data-scroll-animation-animation-value="fade-up">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-3 md:mb-4 text-gradient">Shop by Category</h2>
    <p class="text-base md:text-lg text-medium-contrast max-w-2xl mx-auto px-4">
      Find the perfect embroidery design for your next project from our carefully curated categories.
    </p>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 md:gap-6">
    <!-- Floral -->
    <%= link_to category_path(Category.find_by(name: "Floral Designs")),
        class: "card shadow-xl hover:shadow-2xl transition-all duration-300 cursor-pointer group perspective-1000",
        data: {
          controller: "hover-effect scroll-animation",
          hover_effect_effect_value: "tilt",
          scroll_animation_animation_value: "fade-up",
          scroll_animation_delay_value: 0.1
        } do %>
      <figure class="px-6 pt-6">
        <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center group-hover:bg-primary/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="category-icon text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2C8 2 5 5 5 9c0 2.5 1.5 5 3 6.5C6.5 17 5 19 5 21h14c0-2-1.5-4-3-5.5 1.5-1.5 3-4 3-6.5 0-4-3-7-7-7z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v7m0 0c-2 0-3.5 1.5-3.5 3.5S10 16 12 16s3.5-1.5 3.5-3.5S14 9 12 9z"/>
          </svg>
        </div>
      </figure>
      <div class="card-body items-center text-center py-4">
        <h3 class="card-title text-lg text-high-contrast">Floral</h3>
        <p class="text-sm text-medium-contrast">Beautiful flower designs</p>
      </div>
    <% end %>

    <!-- Animals -->
    <%= link_to category_path(Category.find_by(name: "Animal Patterns")),
        class: "card shadow-xl hover:shadow-2xl transition-all duration-300 cursor-pointer group perspective-1000",
        data: {
          controller: "hover-effect scroll-animation",
          hover_effect_effect_value: "tilt",
          scroll_animation_animation_value: "fade-up",
          scroll_animation_delay_value: 0.2
        } do %>
      <figure class="px-6 pt-6">
        <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center group-hover:bg-secondary/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="category-icon text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 4C5 4 4 5 4 6.5S5 9 6.5 9 9 8 9 6.5 8 4 6.5 4zM17.5 4C16 4 15 5 15 6.5S16 9 17.5 9 20 8 20 6.5 19 4 17.5 4z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9c-3 0-6 2-6 5v3c0 1.5 1 3 3 3h6c2 0 3-1.5 3-3v-3c0-3-3-5-6-5z"/>
            <circle cx="9" cy="14" r="1" fill="currentColor"/>
            <circle cx="15" cy="14" r="1" fill="currentColor"/>
          </svg>
        </div>
      </figure>
      <div class="card-body items-center text-center py-4">
        <h3 class="card-title text-lg text-high-contrast">Animals</h3>
        <p class="text-sm text-medium-contrast">Cute animal patterns</p>
      </div>
    <% end %>

    <!-- Holiday -->
    <%= link_to category_path(Category.find_by(name: "Holidays")),
        class: "card shadow-xl hover:shadow-2xl transition-all duration-300 cursor-pointer group perspective-1000",
        data: {
          controller: "hover-effect scroll-animation",
          hover_effect_effect_value: "tilt",
          scroll_animation_animation_value: "fade-up",
          scroll_animation_delay_value: 0.3
        } do %>
      <figure class="px-6 pt-6">
        <div class="w-16 h-16 bg-accent/10 rounded-full flex items-center justify-center group-hover:bg-accent/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="category-icon text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l1.5 3.5L17 8l-3.5 1.5L12 13l-1.5-3.5L7 8l3.5-1.5L12 3z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l1 2 2 1-2 1-1 2-1-2-2-1 2-1 1-2z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l.75 1.5 1.5.75-1.5.75-.75 1.5-.75-1.5-1.5-.75 1.5-.75.75-1.5z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 19h8M10 21h4"/>
          </svg>
        </div>
      </figure>
      <div class="card-body items-center text-center py-4">
        <h3 class="card-title text-lg text-high-contrast">Holiday</h3>
        <p class="text-sm text-medium-contrast">Seasonal celebrations</p>
      </div>
    <% end %>

    <!-- Monograms -->
    <%= link_to category_path(Category.find_by(name: "Monograms")),
        class: "card shadow-xl hover:shadow-2xl transition-all duration-300 cursor-pointer group perspective-1000",
        data: {
          controller: "hover-effect scroll-animation",
          hover_effect_effect_value: "tilt",
          scroll_animation_animation_value: "fade-up",
          scroll_animation_delay_value: 0.4
        } do %>
      <figure class="px-6 pt-6">
        <div class="w-16 h-16 bg-info/10 rounded-full flex items-center justify-center group-hover:bg-info/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="category-icon text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
          </svg>
        </div>
      </figure>
      <div class="card-body items-center text-center py-4">
        <h3 class="card-title text-lg text-high-contrast">Monograms</h3>
        <p class="text-sm text-medium-contrast">Personalized letters</p>
      </div>
    <% end %>

    <!-- Cooking -->
    <%= link_to category_path(Category.find_by(name: "Cooking")),
        class: "card shadow-xl hover:shadow-2xl transition-all duration-300 cursor-pointer group perspective-1000",
        data: {
          controller: "hover-effect scroll-animation",
          hover_effect_effect_value: "tilt",
          scroll_animation_animation_value: "fade-up",
          scroll_animation_delay_value: 0.5
        } do %>
      <figure class="px-6 pt-6">
        <div class="w-16 h-16 bg-warning/10 rounded-full flex items-center justify-center group-hover:bg-warning/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="category-icon text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.5c-1 0-2 .5-2 1.5v1h4v-1c0-1-1-1.5-2-1.5z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5c-.5 0-1 .5-1 1v1c0 3 2 6 5 7h6c3-1 5-4 5-7v-1c0-.5-.5-1-1-1z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 4v2M12 3v3M16 4v2"/>
          </svg>
        </div>
      </figure>
      <div class="card-body items-center text-center py-4">
        <h3 class="card-title text-lg text-high-contrast">Cooking</h3>
        <p class="text-sm text-medium-contrast">Culinary-themed patterns</p>
      </div>
    <% end %>

    <!-- Celebration -->
    <%= link_to category_path(Category.find_by(name: "Celebrations")),
        class: "card shadow-xl hover:shadow-2xl transition-all duration-300 cursor-pointer group perspective-1000",
        data: {
          controller: "hover-effect scroll-animation",
          hover_effect_effect_value: "tilt",
          scroll_animation_animation_value: "fade-up",
          scroll_animation_delay_value: 0.6
        } do %>
      <figure class="px-6 pt-6">
        <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center group-hover:bg-success/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="category-icon text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 15.5c0 2.5-2 4.5-4.5 4.5S12 18 12 15.5c0-2.8 4.5-7.5 4.5-7.5s4.5 4.7 4.5 7.5z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15.5c0 2.5-2 4.5-4.5 4.5S3 18 3 15.5c0-2.8 4.5-7.5 4.5-7.5s4.5 4.7 4.5 7.5z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l2 4h-4l2-4z"/>
          </svg>
        </div>
      </figure>
      <div class="card-body items-center text-center py-4">
        <h3 class="card-title text-lg text-high-contrast">Celebration</h3>
        <p class="text-sm text-medium-contrast">Party & special occasions</p>
      </div>
    <% end %>
  </div>
</section>

<!-- Featured Products Section -->
<section class="mb-12 md:mb-16 px-2 sm:px-0">
  <div class="text-center mb-8 md:mb-12" data-controller="scroll-animation" data-scroll-animation-animation-value="fade-up">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-3 md:mb-4 text-gradient">Featured Products</h2>
    <p class="text-base md:text-lg text-medium-contrast max-w-2xl mx-auto px-4">
      Discover our most popular embroidery designs, handpicked for their quality and creativity.
    </p>
  </div>

  <% if @featured_products.empty? %>
    <div class="card shadow-xl">
      <div class="card-body text-center py-16">
        <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-primary/10 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold mb-2 text-high-contrast">Coming Soon!</h3>
        <p class="text-medium-contrast mb-6">We're preparing amazing embroidery designs for you. Check back soon!</p>
        <%= link_to "Browse All Products", products_path, class: "btn btn-primary" %>
      </div>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 lg:gap-8">
      <% @featured_products.each_with_index do |product, index| %>
        <div class="card shadow-xl hover:shadow-2xl transition-all duration-300 group"
             data-controller="hover-effect scroll-animation"
             data-hover-effect-effect-value="lift"
             data-scroll-animation-animation-value="fade-up"
             data-scroll-animation-delay-value="<%= (index % 3) * 0.1 %>">
          <figure class="px-6 pt-6 relative overflow-hidden">
            <% if product.images.attached? %>
              <%= image_tag product.images.first, class: "rounded-xl h-56 w-full object-cover group-hover:scale-105 transition-transform duration-300" %>
            <% else %>
              <div class="rounded-xl h-56 w-full bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            <% end %>
            <div class="absolute top-8 right-8">
              <div class="badge badge-primary">Featured</div>
            </div>
          </figure>
          <div class="card-body">
            <h3 class="card-title text-xl mb-2 text-high-contrast">
              <%= product.title %>
              <div class="badge badge-secondary">NEW</div>
            </h3>

            <p class="text-sm text-medium-contrast mb-3">
              <%= truncate(product.description.to_plain_text, length: 60) %>
            </p>

            <div class="flex items-center justify-between">
              <span class="text-2xl font-bold text-primary">$<%= product.price %></span>
              <div class="rating rating-sm">
                <input type="radio" name="rating-<%= product.id %>" class="mask mask-star-2 bg-orange-400" />
                <input type="radio" name="rating-<%= product.id %>" class="mask mask-star-2 bg-orange-400" />
                <input type="radio" name="rating-<%= product.id %>" class="mask mask-star-2 bg-orange-400" />
                <input type="radio" name="rating-<%= product.id %>" class="mask mask-star-2 bg-orange-400" />
                <input type="radio" name="rating-<%= product.id %>" class="mask mask-star-2 bg-orange-400" checked />
              </div>
            </div>
            <div class="card-actions justify-between mt-6">
              <%= link_to "Quick View", product_path(product), class: "btn btn-outline btn-sm flex-1" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="text-center mt-12">
      <%= link_to "View All Products", products_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</section>

