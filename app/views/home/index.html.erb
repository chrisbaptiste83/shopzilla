<!-- Newsletter Section -->
<section class="mb-12 md:mb-16 px-2 sm:px-0" data-controller="scroll-animation" data-scroll-animation-animation-value="scale-up">
  <div class="card bg-gradient-primary text-primary-content shadow-xl">
    <div class="card-body text-center py-8 md:py-12 lg:py-16 px-4">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-3 md:mb-4">Stay Updated</h2>
      <p class="text-base sm:text-lg md:text-xl mb-6 md:mb-8 opacity-90">Get notified about new designs, exclusive offers, and embroidery tips!</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center max-w-md mx-auto">
        <input type="email" placeholder="Enter your email" class="input input-bordered flex-1 text-base-content" />
        <button class="btn btn-accent">Subscribe</button>
      </div>
      <p class="text-sm opacity-75 mt-4">No spam, unsubscribe anytime.</p>
    </div>
  </div>
</section>
