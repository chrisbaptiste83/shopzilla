<!-- Hero Section -->
<section class="sz-hero">
  <%= image_tag "categories/studio.jpg",
        alt: "Finished embroidery designs arranged in Gloria's studio",
        class: "sz-hero-media",
        loading: "eager",
        fetchpriority: "high" %>

  <div class="sz-hero-content">
    <span class="sz-eyebrow sz-fade-up sz-fade-up-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
      </svg>
      Handcrafted Embroidery
    </span>

    <h1 class="sz-headline sz-fade-up sz-fade-up-2">
      Machine-ready<br>
      <span class="sz-gradient-text">embroidery designs</span>
    </h1>

    <p class="sz-subhead sz-fade-up sz-fade-up-3">
      Instant-download embroidery files crafted for all major machines.
      PES, DST, JEF and more. Ready the moment you purchase.
    </p>

    <div class="sz-hero-actions sz-fade-up sz-fade-up-4">
      <%= link_to products_path, class: "sz-cta-primary" do %>
        Shop Now
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      <% end %>
      <%= link_to "Browse Categories", "#categories", class: "sz-cta-outline" %>
    </div>

    <div class="sz-trust-row sz-fade-up sz-fade-up-5">
      <span class="sz-trust-badge">
        <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Instant Download
      </span>
      <span class="sz-trust-badge">
        <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        All Formats
      </span>
      <span class="sz-trust-badge">
        <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Machine Tested
      </span>
    </div>
  </div>

</section>

<!-- Section divider -->
<div class="sz-divider mb-14"></div>

<!-- Categories Section -->
<section id="categories" class="mb-16 px-1">
  <div class="mb-1">
    <p class="sz-section-label">Browse</p>
    <h2 class="sz-section-title">Shop by Category</h2>
  </div>
  <div class="sz-divider my-4"></div>

  <% if @featured_categories.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <% @featured_categories.each do |category| %>
        <%= link_to category_path(category), class: "group relative overflow-hidden rounded-lg aspect-[4/3] block" do %>
          <%= image_tag category_banner_image(category),
                class: "absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105",
                alt: category.name,
                loading: "lazy",
                decoding: "async" %>
          <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-transparent"></div>
          <span class="absolute bottom-3 left-3 right-3 text-white font-bold text-sm leading-snug drop-shadow-sm">
            <%= category.name %>
          </span>
          <span class="absolute top-3 right-3 w-7 h-7 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>

<!-- Featured Products -->
<section class="mb-16 px-1">
  <div class="flex items-end justify-between mb-1">
    <div>
      <p class="sz-section-label">Handpicked</p>
      <h2 class="sz-section-title">Featured Products</h2>
    </div>
    <%= link_to products_path, class: "flex items-center gap-1 text-sm font-semibold pb-1 transition-colors", style: "color:#0f766e" do %>
      View all
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    <% end %>
  </div>
  <div class="sz-divider my-4"></div>

  <% if @featured_products.empty? %>
    <div class="text-center py-16">
      <p class="text-gray-400 text-sm">Designs coming soon.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @featured_products.each do |product| %>
        <div class="sz-product-card group">
          <%= link_to product_path(product) do %>
            <div class="sz-product-image">
              <% if product.images.attached? %>
                <% image_url = imagekit_url(product.primary_image, width: 520, height: 520, crop: "at_max", format: "auto", quality: 74, sharpen: 20) %>
                <%= image_tag image_url,
                      class: "w-full h-52 object-contain",
                      alt: "#{product.title} embroidery preview",
                      loading: "lazy",
                      decoding: "async" %>
              <% else %>
                <div class="w-full h-52 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 opacity-15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              <% end %>
            </div>
          <% end %>
          <div class="p-4">
            <h3 class="font-semibold text-gray-900 mb-2 group-hover:text-teal-700 transition-colors line-clamp-1">
              <%= link_to product.title, product_path(product), class: "hover:no-underline" %>
            </h3>
            <div class="flex items-center justify-between">
              <span class="sz-product-price"><%= number_to_currency(product.price) %></span>
              <% if product.stitch_count.present? %>
                <span class="text-xs text-gray-400 font-medium"><%= number_with_delimiter(product.stitch_count) %> sts</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<!-- Features Strip -->
<div class="sz-divider mb-8"></div>

<section class="mb-14 px-1">
  <div class="sz-features-strip">
    <div class="sz-feature-item">
      <div class="sz-feature-icon">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color:#0f766e" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-1 text-sm">Instant Download</h3>
        <p class="text-sm text-gray-500">Get your designs immediately after purchase.</p>
      </div>
    </div>
    <div class="sz-feature-item">
      <div class="sz-feature-icon">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color:#0f766e" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-1 text-sm">Multiple Formats</h3>
        <p class="text-sm text-gray-500">PES, DST, JEF and more — compatible with all major machines.</p>
      </div>
    </div>
    <div class="sz-feature-item">
      <div class="sz-feature-icon">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" style="color:#0f766e" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-gray-900 mb-1 text-sm">Tested Quality</h3>
        <p class="text-sm text-gray-500">Hand-crafted designs tested on real machines.</p>
      </div>
    </div>
  </div>
</section>
