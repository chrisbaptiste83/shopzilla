<div style="font-family: Arial, Helvetica, sans-serif; line-height: 1.6; color: #18212a; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="border-bottom: 3px solid #087f7a; padding-bottom: 12px; margin-bottom: 20px;">
    <h2 style="color: #087f7a; margin: 0; font-size: 20px;">New Message from Gloria's Embroidery</h2>
    <p style="color: #52616d; margin: 4px 0 0; font-size: 13px;">Received via gloriasembroideryshop.com/contact</p>
  </div>

  <table style="width: 100%; margin-bottom: 20px; border-collapse: collapse; font-size: 14px;">
    <tr>
      <td style="padding: 6px 0; font-weight: bold; width: 100px; color: #52616d;">From:</td>
      <td style="padding: 6px 0;"><%= @name %> (&lt;<a href="mailto:<%= @email %>" style="color: #087f7a;"><%= @email %></a>&gt;)</td>
    </tr>
    <tr>
      <td style="padding: 6px 0; font-weight: bold; color: #52616d;">Topic:</td>
      <td style="padding: 6px 0;"><%= @subject %></td>
    </tr>
  </table>

  <div style="background-color: #f3f6f7; border-left: 4px solid #087f7a; padding: 16px; border-radius: 4px; margin-bottom: 20px; font-size: 14px;">
    <p style="margin: 0; white-space: pre-wrap;"><%= @message %></p>
  </div>

  <p style="font-size: 12px; color: #52616d; border-top: 1px solid #c9d2d8; padding-top: 14px; margin-top: 24px;">
    You can hit <strong>Reply</strong> in your email client to respond directly to <%= @name %> (<%= @email %>).
  </p>
</div>
