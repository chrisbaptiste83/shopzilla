<% content_for :page_title, "Your Cart" %>

<header class="catalog-header">
  <div>
    <p class="sz-section-label">Your selection</p>
    <h1>Shopping cart</h1>
    <p>Review your designs before continuing to secure checkout.</p>
  </div>
</header>

<% if @products.any? %>
  <div class="cart-layout">
    <section class="cart-items" aria-label="Cart items">
      <% @products.each do |product| %>
        <% quantity = @cart.fetch(product.id.to_s, 0).to_i %>
        <article class="cart-item">
          <%= link_to product_path(product), class: "cart-item-media" do %>
            <% if product.images.attached? %>
              <%= image_tag product.primary_image,
                    alt: "#{product.title} embroidery preview",
                    loading: "lazy" %>
            <% else %>
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            <% end %>
          <% end %>
          <div class="cart-item-copy">
            <p class="text-xs text-base-content/55"><%= product.category.name %></p>
            <h2><%= link_to product.title, product_path(product) %></h2>
            <p class="text-sm text-base-content/60"><%= pluralize(quantity, "license") %></p>
          </div>
          <div class="cart-item-price"><%= number_to_currency(product.price * quantity) %></div>
          <%= button_to remove_cart_path(product_id: product.id),
                method: :delete,
                class: "btn btn-ghost btn-square btn-sm",
                aria: { label: "Remove #{product.title} from cart" },
                title: "Remove from cart" do %>
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
        </article>
      <% end %>
    </section>

    <aside class="cart-summary" aria-labelledby="order-summary-heading">
      <h2 id="order-summary-heading">Order summary</h2>
      <div class="cart-summary-row">
        <span>Subtotal</span>
        <strong><%= number_to_currency(@subtotal) %></strong>
      </div>
      <p>Taxes, when applicable, are calculated during checkout.</p>
      <%= button_to "Continue to checkout", checkout_path, method: :post, class: "btn btn-primary w-full", data: { turbo: false } %>
      <%= link_to "Continue shopping", products_path, class: "btn btn-ghost w-full" %>
      <%= button_to "Clear cart", clear_cart_path, method: :delete, class: "cart-clear-action" %>
    </aside>
  </div>
<% else %>
  <div class="catalog-empty">
    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.3 2.6A1 1 0 006.6 17H18m-9 4h.01M17 21h.01" />
    </svg>
    <h2>Your cart is empty</h2>
    <p>Explore the catalog to find your next project.</p>
    <%= link_to "Browse designs", products_path, class: "btn btn-primary" %>
  </div>
<% end %>
