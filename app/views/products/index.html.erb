<% content_for :page_title, "Embroidery Designs" %>
<% filters_active = params.values_at(:search, :category_id, :file_format, :sort, :stitch_min, :stitch_max).any?(&:present?) %>

<header class="catalog-header">
  <div>
    <p class="sz-section-label">Design catalog</p>
    <h1>Embroidery designs</h1>
    <p>Machine-ready files for your next stitching project.</p>
  </div>
  <p class="catalog-count"><%= pluralize(@products.total_count, "design") %></p>
</header>

<section class="catalog-filters" aria-label="Product filters">
  <%= form_with url: products_path, method: :get, local: true, class: "catalog-filter-grid" do |f| %>
    <div class="catalog-search-field">
      <%= f.label :search, "Search designs", class: "catalog-filter-label" %>
      <%= f.search_field :search, value: params[:search], placeholder: "Title or description",
            class: "input input-bordered w-full", autocomplete: "off" %>
    </div>

    <div>
      <%= label_tag :category_id, "Category", class: "catalog-filter-label" %>
      <%= select_tag :category_id,
            options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
            include_blank: "All categories",
            class: "select select-bordered w-full" %>
    </div>

    <div>
      <%= label_tag :file_format, "File format", class: "catalog-filter-label" %>
      <%= select_tag :file_format,
            options_for_select(@file_formats, params[:file_format]),
            include_blank: "All formats",
            class: "select select-bordered w-full" %>
    </div>

    <div>
      <%= label_tag :sort, "Sort by", class: "catalog-filter-label" %>
      <%= select_tag :sort,
            options_for_select([
              [ "Newest", "newest" ],
              [ "Price: low to high", "price_low" ],
              [ "Price: high to low", "price_high" ]
            ], params[:sort]),
            include_blank: "Recommended",
            class: "select select-bordered w-full" %>
    </div>

    <details class="catalog-advanced" <%= "open" if params[:stitch_min].present? || params[:stitch_max].present? %>>
      <summary>Stitch count</summary>
      <div class="catalog-stitch-fields">
        <div>
          <%= f.label :stitch_min, "Minimum", class: "catalog-filter-label" %>
          <%= f.number_field :stitch_min, value: params[:stitch_min], min: 0, placeholder: "0",
                class: "input input-bordered w-full" %>
        </div>
        <div>
          <%= f.label :stitch_max, "Maximum", class: "catalog-filter-label" %>
          <%= f.number_field :stitch_max, value: params[:stitch_max], min: 0, placeholder: "Any",
                class: "input input-bordered w-full" %>
        </div>
      </div>
    </details>

    <div class="catalog-filter-actions">
      <%= f.submit "Apply filters", class: "btn btn-primary" %>
      <%= link_to "Clear", products_path, class: "btn btn-ghost" if filters_active %>
    </div>
  <% end %>
</section>

<% if @products.empty? %>
  <div class="catalog-empty">
    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
    </svg>
    <h2>No matching designs</h2>
    <p>Try a broader search or remove one of your filters.</p>
    <%= link_to "View all designs", products_path, class: "btn btn-outline btn-sm" %>
  </div>
<% else %>
  <div class="product-card-grid">
    <%= render partial: "catalog_product", collection: @products, as: :product %>
  </div>

  <nav class="mt-10 flex justify-center" aria-label="Product pages">
    <%= paginate @products %>
  </nav>
<% end %>
