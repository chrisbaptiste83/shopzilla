<!-- Breadcrumb -->
<div class="text-sm breadcrumbs mb-8 opacity-60">
  <ul>
    <li><%= link_to "Home", root_path %></li>
    <li><%= link_to "Products", products_path %></li>
    <li><%= link_to @product.category.name, category_path(@product.category) %></li>
    <li class="font-medium opacity-100"><%= @product.title %></li>
  </ul>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-20">
  <!-- Product Images -->
  <div data-controller="product-gallery">
    <% if @product.images.attached? %>
      <% _ik_main = imagekit_url(@product.images.first, width: 1200, height: 1200, format: "auto", quality: 85) %>
      <%= image_tag(_ik_main || @product.images.first.variant(resize_to_limit: [1200, 1200]),
            class: "rounded-2xl w-full h-96 object-contain bg-base-200",
            data: { product_gallery_target: "mainImage" }) %>
    <% else %>
      <div class="rounded-2xl w-full h-96 bg-base-200 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    <% end %>

    <!-- Thumbnails -->
    <% if @product.images.attached? && @product.images.count > 1 %>
      <div class="grid grid-cols-5 gap-2 mt-3">
        <% @product.images.each do |image| %>
          <% _ik_thumb = imagekit_url(image, width: 200, height: 200, format: "auto", quality: 80) %>
          <% _ik_full  = imagekit_url(image, width: 1200, height: 1200, format: "auto", quality: 85) ||
                           url_for(image.variant(resize_to_limit: [1200, 1200])) %>
          <%= image_tag(_ik_thumb || image.variant(resize_to_limit: [200, 200]),
                class: "rounded-lg w-full h-16 object-contain bg-base-200 cursor-pointer opacity-50 hover:opacity-100 transition-opacity",
                data: {
                  action: "click->product-gallery#select",
                  product_gallery_full_src: _ik_full,
                  product_gallery_target: "thumbnail"
                }) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Product Details -->
  <div class="flex flex-col gap-7">
    <!-- Category + Title + Price -->
    <div>
      <% if @product.category.present? %>
        <span class="text-xs uppercase tracking-widest text-base-content/40 font-medium">
          <%= @product.category.name %>
        </span>
      <% end %>
      <h1 class="text-3xl font-bold mt-2 mb-5"><%= @product.title %></h1>
      <div class="text-3xl font-bold text-primary">$<%= @product.price %></div>
    </div>

    <!-- Stitch Count — Primary Attribute -->
    <% if @product.stitch_count.present? %>
      <div class="flex items-center gap-4 p-4 rounded-xl bg-base-200/60 border border-base-300">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
          </svg>
        </div>
        <div>
          <div class="text-xs text-base-content/40 uppercase tracking-wide mb-0.5">Stitch Count</div>
          <div class="text-2xl font-bold"><%= number_with_delimiter(@product.stitch_count) %></div>
        </div>
      </div>
    <% end %>

    <!-- Description -->
    <p class="text-base-content/65 leading-relaxed">
      <%= @product.description.present? ? @product.description.to_plain_text : "This embroidery design is crafted with attention to detail and tested on multiple machine types for optimal results." %>
    </p>

    <!-- Specs row -->
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-base-content/55">
      <% if @product.dimensions.present? %>
        <span><span class="font-semibold text-base-content/80">Dimensions</span> · <%= @product.dimensions %></span>
      <% end %>
      <% if @product.file_format.present? %>
        <span><span class="font-semibold text-base-content/80">Formats</span> · <%= @product.file_format %></span>
      <% end %>
      <% if @product.embroidery_file.attached? %>
        <span class="text-success font-medium">✓ Instant download</span>
      <% end %>
    </div>

    <!-- Actions -->
    <div class="flex flex-col gap-3">
      <div class="flex gap-3">
        <!-- Wishlist -->
        <% if user_signed_in? %>
          <% if in_wishlist?(@product) %>
            <%= form_with url: wishlist_item_path(wishlist_item_for(@product)), method: :delete, local: true do %>
              <button type="submit" class="btn btn-error btn-outline btn-square" title="Remove from wishlist">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </button>
            <% end %>
          <% else %>
            <%= form_with url: wishlist_items_path, method: :post, local: true do %>
              <%= hidden_field_tag :product_id, @product.id %>
              <button type="submit" class="btn btn-outline btn-square" title="Add to wishlist">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </button>
            <% end %>
          <% end %>
        <% end %>

        <!-- Add to Cart -->
        <%= form_with url: add_cart_path, method: :post, local: true, class: "flex-1" do %>
          <%= hidden_field_tag :product_id, @product.id %>
          <button type="submit" class="btn btn-outline w-full">Add to Cart</button>
        <% end %>
      </div>

      <!-- Buy Now -->
      <% if user_signed_in? %>
        <%= form_with url: checkout_path(product_id: @product.id), method: :post, data: { turbo: false } do %>
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <button class="btn btn-primary w-full">Buy Now — Instant Download</button>
        <% end %>
      <% else %>
        <%= link_to "Sign in to Purchase", new_user_session_path, class: "btn btn-primary w-full" %>
      <% end %>
    </div>

    <!-- Admin / Back -->
    <div class="flex gap-3 pt-2">
      <% if current_user&.admin? %>
        <%= link_to "Edit", edit_product_path(@product), class: "btn btn-ghost btn-sm" %>
      <% end %>
      <%= link_to "← All Products", products_path, class: "btn btn-ghost btn-sm" %>
    </div>
  </div>
</div>

<!-- Related Products -->
<% related_products = @product.category.products.where.not(id: @product.id).limit(4) %>
<% if related_products.any? %>
  <section class="border-t border-base-300 pt-12">
    <h2 class="text-lg font-semibold mb-6 text-base-content/60">You Might Also Like</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% related_products.each do |related| %>
        <%= link_to product_path(related), class: "group block" do %>
          <% if related.images.attached? %>
            <% _ik_rel = imagekit_url(related.images.first, width: 400, height: 400, format: "auto", quality: 80) %>
            <%= image_tag(_ik_rel || related.images.first, class: "rounded-xl w-full h-36 object-contain bg-base-200 group-hover:opacity-80 transition-opacity mb-3") %>
          <% else %>
            <div class="rounded-xl w-full h-36 bg-base-200 mb-3"></div>
          <% end %>
          <div class="text-sm font-medium group-hover:text-primary transition-colors"><%= related.title %></div>
          <div class="text-sm text-base-content/50 mt-0.5">$<%= related.price %></div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
