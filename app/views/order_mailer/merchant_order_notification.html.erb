<div style="font-family: Arial, Helvetica, sans-serif; line-height: 1.6; color: #18212a; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="border-bottom: 3px solid #087f7a; padding-bottom: 12px; margin-bottom: 20px;">
    <h2 style="color: #087f7a; margin: 0; font-size: 22px;">You Made a Sale! 🎉</h2>
    <p style="color: #52616d; margin: 4px 0 0; font-size: 14px;">Order #<%= @order.id %> · Total: <%= number_to_currency(@order.total) %></p>
  </div>

  <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px;">
    <tr>
      <td style="padding: 6px 0; font-weight: bold; width: 120px; color: #52616d;">Customer:</td>
      <td style="padding: 6px 0;"><%= @user.email %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; font-weight: bold; color: #52616d;">Date:</td>
      <td style="padding: 6px 0;"><%= @order.created_at.strftime("%B %d, %Y at %I:%M %p %Z") %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; font-weight: bold; color: #52616d;">Payment ID:</td>
      <td style="padding: 6px 0;"><code><%= @order.stripe_session_id %></code></td>
    </tr>
  </table>

  <h3 style="color: #075b58; font-size: 16px; margin: 16px 0 8px;">Items Purchased:</h3>
  <ul style="font-size: 14px; margin-bottom: 20px;">
    <% @order.order_items.each do |item| %>
      <li><strong><%= item.product.title %></strong> (Qty: <%= item.quantity %>) — <%= number_to_currency(item.unit_price) %></li>
    <% end %>
  </ul>

  <p style="margin-top: 24px;">
    <a href="<%= admin_order_url(@order) rescue admin_root_url %>" style="display: inline-block; background: #087f7a; color: #ffffff; padding: 10px 18px; border-radius: 4px; text-decoration: none; font-weight: bold;">
      View Order in Admin Panel
    </a>
  </p>
</div>
