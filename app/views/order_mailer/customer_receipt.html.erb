<div style="font-family: Arial, Helvetica, sans-serif; line-height: 1.6; color: #18212a; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="border-bottom: 3px solid #087f7a; padding-bottom: 12px; margin-bottom: 20px;">
    <h2 style="color: #087f7a; margin: 0; font-size: 22px;">Thank You for Your Order!</h2>
    <p style="color: #52616d; margin: 4px 0 0; font-size: 14px;">Order #<%= @order.id %> · <%= @order.created_at.strftime("%B %d, %Y") %></p>
  </div>

  <p>Hi <%= @user.email %>,</p>
  <p>Your order has been completed successfully. You can download your embroidery files below or access them anytime from your account dashboard.</p>

  <h3 style="color: #075b58; font-size: 16px; margin: 20px 0 8px;">Order Summary</h3>
  <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px;">
    <thead>
      <tr style="background: #263943; color: #ffffff;">
        <th style="padding: 8px 10px; text-align: left;">Item</th>
        <th style="padding: 8px 10px; text-align: center;">Qty</th>
        <th style="padding: 8px 10px; text-align: right;">Price</th>
      </tr>
    </thead>
    <tbody>
      <% @order_items.each do |item| %>
        <tr style="border-bottom: 1px solid #c9d2d8;">
          <td style="padding: 8px 10px;"><%= item.product.title %></td>
          <td style="padding: 8px 10px; text-align: center;"><%= item.quantity %></td>
          <td style="padding: 8px 10px; text-align: right;"><%= number_to_currency(item.unit_price) %></td>
        </tr>
      <% end %>
      <tr style="font-weight: bold; background: #f3f6f7;">
        <td colspan="2" style="padding: 10px; text-align: right;">Total Paid:</td>
        <td style="padding: 10px; text-align: right; color: #087f7a;"><%= number_to_currency(@order.total) %></td>
      </tr>
    </tbody>
  </table>

  <% if @downloads.any? %>
    <div style="background: #eef7f6; border-left: 4px solid #087f7a; padding: 16px; border-radius: 4px; margin-bottom: 24px;">
      <h3 style="color: #075b58; margin: 0 0 10px; font-size: 16px;">Your Digital Downloads (.PES)</h3>
      <p style="font-size: 13px; color: #52616d; margin-bottom: 12px;">Download links are active for 30 days. You can also re-download anytime by logging into your account.</p>
      <ul style="margin: 0; padding-left: 20px;">
        <% @downloads.each do |download| %>
          <li style="margin-bottom: 8px;">
            <strong><%= download.product.title %></strong>:
            <a href="<%= secure_download_url(download.access_token) %>" style="color: #087f7a; font-weight: bold; text-decoration: underline;">
              Download PES File
            </a>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p style="font-size: 13px; color: #52616d;">
    Need assistance or have questions about hoop sizing or stitch count? Reply directly to this email or visit
    <a href="<%= contact_url %>" style="color: #087f7a;">our contact page</a>.
  </p>

  <p style="font-size: 12px; color: #8c9ba5; border-top: 1px solid #c9d2d8; padding-top: 14px; margin-top: 24px;">
    Gloria's Embroidery · <a href="<%= root_url %>" style="color: #52616d;">gloriasembroideryshop.com</a>
  </p>
</div>
