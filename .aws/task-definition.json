{
  "family": "shopzilla",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "arn:aws:iam::673588459621:role/ecsTaskExecutionRole",
  "cpu": "768",
  "memory": "1152",
  "volumes": [
    {
      "name": "postgres-data",
      "host": { "sourcePath": "/data/shopzilla/postgres" }
    }
  ],
  "containerDefinitions": [
    {
      "name": "postgres",
      "image": "postgres:16",
      "essential": true,
      "environment": [
        { "name": "POSTGRES_USER",     "value": "rails" },
        { "name": "POSTGRES_DB",       "value": "shopzilla_production" },
        { "name": "POSTGRES_PASSWORD", "value": "d8f005abdaed2747f3af84ea18a9995e85a2538a" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "postgres-data",
          "containerPath": "/var/lib/postgresql/data",
          "readOnly": false
        }
      ],
      "portMappings": [
        { "containerPort": 5432, "protocol": "tcp" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shopzilla",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "postgres",
          "awslogs-create-group": "true"
        }
      },
      "memory": 256,
      "cpu": 128
    },
    {
      "name": "shopzilla",
      "image": "673588459621.dkr.ecr.us-east-2.amazonaws.com/shopzilla:latest",
      "essential": true,
      "dependsOn": [
        { "containerName": "postgres", "condition": "START" }
      ],
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "RAILS_ENV",                "value": "production" },
        { "name": "ACTIVE_STORAGE_SERVICE",   "value": "amazon" },
        { "name": "SOLID_QUEUE_IN_PUMA",      "value": "true" },
        { "name": "RAILS_LOG_TO_STDOUT",      "value": "true" },
        { "name": "RAILS_LOG_LEVEL",          "value": "info" },
        { "name": "RAILS_SERVE_STATIC_FILES", "value": "true" },
        { "name": "PORT",                     "value": "3000" },
        { "name": "FRONTEND_URL",             "value": "https://gloriasembroideryshop.com" },
        { "name": "STRIPE_PUBLISHABLE_KEY",   "value": "pk_live_51RpoJNRvD8xPSLFB5jDzQn6LOleyWHoc3ehv2h8ArfVZAIdG4sjBnS2DVfz7q9f49R9u1m4OB1gwlr9rfYSjhvdP00nV9YXhS4" },
        { "name": "IMAGEKIT_URL_ENDPOINT",    "value": "https://ik.imagekit.io/mlvnqaq3b" }
      ],
      "secrets": [
        {
          "name": "RAILS_MASTER_KEY",
          "valueFrom": "/shopzilla/rails-master-key"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "/shopzilla/database-url"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "/shopzilla/stripe-secret-key"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "valueFrom": "/shopzilla/google-client-id"
        },
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "valueFrom": "/shopzilla/google-client-secret"
        },
        {
          "name": "GITHUB_CLIENT_ID",
          "valueFrom": "/shopzilla/github-client-id"
        },
        {
          "name": "GITHUB_CLIENT_SECRET",
          "valueFrom": "/shopzilla/github-client-secret"
        },
        {
          "name": "IMAGEKIT_PRIVATE_KEY",
          "valueFrom": "/shopzilla/imagekit-private-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shopzilla",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "web",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -sf http://localhost:3000/up || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "command": ["./bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"],
      "stopTimeout": 30,
      "memory": 896,
      "cpu": 640
    }
  ]
}
