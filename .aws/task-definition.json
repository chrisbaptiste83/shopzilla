{
  "family": "shopzilla",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "arn:aws:iam::570823560193:role/service-role/ecsTaskExecutionRole",
  "cpu": "512",
  "memory": "896",
  "containerDefinitions": [
    {
      "name": "shopzilla",
      "image": "570823560193.dkr.ecr.us-east-2.amazonaws.com/shopzilla:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "RAILS_ENV",              "value": "production" },
        { "name": "ACTIVE_STORAGE_SERVICE", "value": "amazon" },
        { "name": "SOLID_QUEUE_IN_PUMA",    "value": "true" },
        { "name": "RAILS_LOG_TO_STDOUT",    "value": "true" },
        { "name": "RAILS_LOG_LEVEL",        "value": "info" },
        { "name": "RAILS_SERVE_STATIC_FILES", "value": "true" },
        { "name": "PORT",                   "value": "3000" },
        { "name": "FRONTEND_URL",           "value": "https://gloriasembroideryshop.com" },
        {
          "name": "STRIPE_PUBLISHABLE_KEY",
          "value": "pk_live_51RpoJNRvD8xPSLFB5jDzQn6LOleyWHoc3ehv2h8ArfVZAIdG4sjBnS2DVfz7q9f49R9u1m4OB1gwlr9rfYSjhvdP00nV9YXhS4"
        }
      ],
      "secrets": [
        {
          "name": "RAILS_MASTER_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:570823560193:secret:shopzilla/rails-master-key-t68fE8"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:570823560193:secret:shopzilla/database-url-KWwQdy"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:570823560193:secret:shopzilla/stripe-secret-key-AmudA7"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shopzilla",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -sf http://localhost:3000/up || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "command": ["./bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"],
      "stopTimeout": 30
    }
  ]
}
